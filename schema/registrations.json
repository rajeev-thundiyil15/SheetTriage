{
  "name": "event_registrations",
  "columns": {
    "registration_id": {
      "dtype": "int",
      "nullable": false
    },
    "attendee": {
      "dtype": "str",
      "nullable": false
    },
    "email": {
      "dtype": "str",
      "nullable": false,
      "pattern": ".+@.+\\..+"
    },
    "ticket_type": {
      "dtype": "str",
      "nullable": false,
      "allowed_values": [
        "General",
        "VIP",
        "Student",
        "Speaker"
      ]
    },
    "price": {
      "dtype": "float",
      "nullable": false,
      "min_value": 0,
      "max_value": 500
    },
    "quantity": {
      "dtype": "int",
      "nullable": false,
      "min_value": 1,
      "max_value": 10
    },
    "registered_on": {
      "dtype": "date",
      "nullable": false,
      "date_format": "MDY"
    },
    "country": {
      "dtype": "str",
      "nullable": false,
      "allowed_values": [
        "USA",
        "Canada",
        "UK",
        "Germany",
        "India"
      ]
    },
    "notes": {
      "dtype": "str",
      "nullable": true
    }
  }
}
